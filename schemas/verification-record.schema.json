{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/verification-record.schema.json",
  "title": "KSpaceJet VerificationRecord",
  "description": "Immutable result from the independent verifier for one frozen ExecutionPlan. It records verified conclusions and resource/terminal bounds; it does not carry a second executable graph or make an admission decision.",
  "type": "object",
  "required": [
    "kind",
    "execution_plan_digest",
    "execution_profile",
    "verified_resource_vector",
    "verified_terminal_occurrences",
    "verified_obligations"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "kind": {
      "const": "VerificationRecord"
    },
    "execution_plan_digest": {
      "$ref": "#/$defs/digest"
    },
    "execution_profile": {
      "$ref": "#/$defs/executionProfile"
    },
    "verified_resource_vector": {
      "$ref": "#/$defs/resourceVector"
    },
    "verified_terminal_occurrences": {
      "$ref": "#/$defs/positiveSafeInteger"
    },
    "verified_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executionProfile": {
      "type": "string",
      "enum": [
        "offline",
        "bounded-online",
        "isolated-strict-online",
        "deadline-qualified-online",
        "research-unbounded"
      ]
    },
    "deviceResourceSlot": {
      "type": "object",
      "required": [
        "device_id",
        "device_bytes",
        "gpu_stream_slots",
        "copy_engine_slots"
      ],
      "properties": {
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "device_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "gpu_stream_slots": {
          "$ref": "#/$defs/safeInteger"
        },
        "copy_engine_slots": {
          "$ref": "#/$defs/safeInteger"
        }
      },
      "additionalProperties": false
    },
    "resourceVector": {
      "type": "object",
      "required": [
        "host_normal_bytes",
        "host_pinned_bytes",
        "host_hugepage_bytes",
        "shared_host_bytes",
        "spool_bytes",
        "transport_bytes",
        "descriptor_count",
        "async_token_count",
        "cpu_leaf_permits",
        "backend_gang_permits",
        "provider_private_permits",
        "io_slots",
        "devices"
      ],
      "properties": {
        "host_normal_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "host_pinned_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "host_hugepage_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "shared_host_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "spool_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "transport_bytes": {
          "$ref": "#/$defs/safeInteger"
        },
        "descriptor_count": {
          "$ref": "#/$defs/safeInteger"
        },
        "async_token_count": {
          "$ref": "#/$defs/safeInteger"
        },
        "cpu_leaf_permits": {
          "$ref": "#/$defs/safeInteger"
        },
        "backend_gang_permits": {
          "$ref": "#/$defs/safeInteger"
        },
        "provider_private_permits": {
          "$ref": "#/$defs/safeInteger"
        },
        "io_slots": {
          "$ref": "#/$defs/safeInteger"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deviceResourceSlot"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
