{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/v1/operator-contract-v1.schema.json",
  "title": "KSpaceJet OperatorContract v1",
  "description": "Provider-owned immutable execution contract. The detached contract digest belongs in the Provider bundle manifest and ResolvedPipeline, never inside this self-describing payload.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "operator_id",
    "operator_revision",
    "provider_abi_major",
    "supported_profiles",
    "ports",
    "execution",
    "batch",
    "rates",
    "resources",
    "calibration",
    "terminal"
  ],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_version": { "const": "kspacejet.operator-contract/v1" },
    "kind": { "const": "OperatorContract" },
    "operator_id": { "$ref": "#/$defs/identifier" },
    "operator_revision": { "$ref": "#/$defs/semver" },
    "provider_abi_major": { "$ref": "#/$defs/positiveSafeInteger" },
    "supported_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/executionProfile" }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/port" }
    },
    "execution": { "$ref": "#/$defs/executionShape" },
    "batch": { "$ref": "#/$defs/batch" },
    "rates": { "$ref": "#/$defs/rates" },
    "resources": { "$ref": "#/$defs/resources" },
    "calibration": { "$ref": "#/$defs/calibration" },
    "join": { "$ref": "#/$defs/join" },
    "reorder": { "$ref": "#/$defs/reorder" },
    "terminal": { "$ref": "#/$defs/terminal" }
  },
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "lowerIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executionProfile": {
      "type": "string",
      "enum": [
        "offline",
        "bounded-online",
        "isolated-strict-online",
        "deadline-qualified-online",
        "research-unbounded"
      ]
    },
    "typeDescriptor": {
      "type": "object",
      "required": [
        "type_id",
        "revision",
        "abi_descriptor_digest",
        "payload_schema_digest",
        "payload_kind",
        "element_type",
        "rank",
        "dimensions",
        "layout",
        "strides",
        "explicit_byte_strides",
        "allowed_memory_domains",
        "min_alignment_bytes",
        "mutability",
        "metadata_schema_digest"
      ],
      "properties": {
        "type_id": { "$ref": "#/$defs/lowerIdentifier" },
        "revision": { "$ref": "#/$defs/positiveSafeInteger" },
        "abi_descriptor_digest": { "$ref": "#/$defs/digest" },
        "payload_schema_digest": { "$ref": "#/$defs/digest" },
        "payload_kind": { "enum": ["buffer_handle", "message_handle", "control_token", "opaque_handle"] },
        "element_type": {
          "enum": [
            "none",
            "uint8",
            "int16",
            "uint16",
            "int32",
            "uint32",
            "float32",
            "float64",
            "complex_int16",
            "complex_float32",
            "complex_float64"
          ]
        },
        "rank": { "$ref": "#/$defs/safeInteger" },
        "dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lowerIdentifier" }
        },
        "layout": {
          "enum": [
            "canonical_contiguous",
            "channel_major_contiguous",
            "row_major_contiguous",
            "column_major_contiguous",
            "opaque"
          ]
        },
        "strides": { "enum": ["canonical", "explicit_byte_strides"] },
        "explicit_byte_strides": {
          "type": "array",
          "items": { "$ref": "#/$defs/positiveSafeInteger" }
        },
        "allowed_memory_domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["host_normal", "host_pinned", "host_hugepage", "shared_host", "cuda_device"] }
        },
        "min_alignment_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Must be a power of two; JSON Schema cannot express that arithmetic predicate."
        },
        "mutability": { "enum": ["immutable_after_publish", "mutable_exclusive"] },
        "metadata_schema_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        {
          "if": { "properties": { "payload_kind": { "const": "buffer_handle" } } },
          "then": { "properties": { "element_type": { "not": { "const": "none" } } } }
        },
        {
          "if": { "properties": { "payload_kind": { "const": "control_token" } } },
          "then": { "properties": { "element_type": { "const": "none" } } }
        },
        {
          "if": { "properties": { "strides": { "const": "canonical" } } },
          "then": { "properties": { "explicit_byte_strides": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": [
        "name",
        "type_descriptor",
        "direction",
        "cardinality",
        "required",
        "layout_capabilities",
        "metadata_capabilities"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "type_descriptor": { "$ref": "#/$defs/typeDescriptor" },
        "direction": { "enum": ["input", "output"] },
        "cardinality": { "enum": ["single", "many"] },
        "required": { "type": "boolean" },
        "layout_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "metadata_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "additionalProperties": false
    },
    "channelGroup": {
      "type": "object",
      "required": [
        "source",
        "channels_per_group",
        "max_active_channels",
        "max_groups",
        "max_charged_bytes_per_group"
      ],
      "properties": {
        "source": { "const": "acquisition_active_channel_range" },
        "channels_per_group": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_active_channels": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_groups": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_charged_bytes_per_group": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "executionShape": {
      "type": "object",
      "required": [
        "input_granularity",
        "partition_key",
        "order_domain",
        "max_active_keys",
        "max_in_flight",
        "call_model",
        "max_items_per_activation",
        "cooperative_quantum_us"
      ],
      "properties": {
        "input_granularity": { "enum": ["acquisition", "microbatch", "window", "frame", "volume", "scan_finalizer"] },
        "partition_key": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "channel_group": { "$ref": "#/$defs/channelGroup" },
        "order_domain": { "enum": ["strict_global", "per_key", "unordered"] },
        "max_active_keys": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_in_flight": { "$ref": "#/$defs/positiveSafeInteger" },
        "call_model": { "enum": ["serial", "keyed_parallel"] },
        "max_items_per_activation": { "$ref": "#/$defs/positiveSafeInteger" },
        "cooperative_quantum_us": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "required": ["min_items", "preferred_items", "max_items", "max_charged_bytes", "max_wait_us"],
      "properties": {
        "min_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "preferred_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_charged_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_wait_us": { "$ref": "#/$defs/safeInteger" }
      },
      "additionalProperties": false
    },
    "portRate": {
      "type": "object",
      "required": ["port_name", "items", "charged_bytes"],
      "properties": {
        "port_name": { "$ref": "#/$defs/identifier" },
        "items": { "$ref": "#/$defs/safeInteger" },
        "charged_bytes": { "$ref": "#/$defs/safeInteger" }
      },
      "additionalProperties": false
    },
    "ratePhase": {
      "type": "object",
      "required": ["inputs", "outputs"],
      "properties": {
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/portRate" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/portRate" } }
      },
      "additionalProperties": false
    },
    "dynamicPhase": {
      "type": "object",
      "required": ["max_firings", "outputs"],
      "properties": {
        "max_firings": { "$ref": "#/$defs/safeInteger" },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/portRate" } }
      },
      "additionalProperties": false
    },
    "completion": {
      "type": "object",
      "required": ["kind", "expected_count", "on_end_of_input"],
      "properties": {
        "kind": { "enum": ["expected_count", "header_predicate", "watermark", "end_of_key", "end_of_input"] },
        "expected_count": { "$ref": "#/$defs/safeInteger" },
        "on_end_of_input": { "enum": ["fail", "partial_output", "skip"] }
      },
      "additionalProperties": false
    },
    "rates": {
      "type": "object",
      "required": ["kind", "completion", "static_phases", "ordinary", "normal_flush", "cancel_cleanup"],
      "properties": {
        "kind": { "enum": ["sdf", "csdf", "keyed_dynamic"] },
        "completion": { "$ref": "#/$defs/completion" },
        "static_phases": { "type": "array", "items": { "$ref": "#/$defs/ratePhase" } },
        "ordinary": { "$ref": "#/$defs/dynamicPhase" },
        "normal_flush": { "$ref": "#/$defs/dynamicPhase" },
        "cancel_cleanup": { "$ref": "#/$defs/dynamicPhase" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "sdf" } } },
          "then": { "properties": { "static_phases": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "csdf" } } },
          "then": { "properties": { "static_phases": { "minItems": 2 } } }
        },
        {
          "if": { "properties": { "kind": { "const": "keyed_dynamic" } } },
          "then": { "properties": { "static_phases": { "maxItems": 0 } } }
        }
      ],
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "scratch_charged_bytes_per_firing",
        "per_key_state_charged_bytes",
        "per_scan_workspace_charged_bytes",
        "retention_items",
        "retention_charged_bytes",
        "output_items",
        "output_charged_bytes",
        "cpu_permits",
        "backend_gang_threads",
        "provider_private_threads",
        "external_allocation_charged_bytes",
        "memory_domain"
      ],
      "properties": {
        "scratch_charged_bytes_per_firing": { "$ref": "#/$defs/safeInteger" },
        "per_key_state_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "per_scan_workspace_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "retention_items": { "$ref": "#/$defs/safeInteger" },
        "retention_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "output_items": { "$ref": "#/$defs/safeInteger" },
        "output_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "cpu_permits": { "$ref": "#/$defs/safeInteger" },
        "backend_gang_threads": { "$ref": "#/$defs/safeInteger" },
        "provider_private_threads": { "$ref": "#/$defs/safeInteger" },
        "external_allocation_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "memory_domain": { "enum": ["host", "pinned_host", "device", "shared"] }
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": [
        "role",
        "binding_id",
        "key_projection",
        "single_epoch_v1",
        "max_active_keys",
        "precalibration_horizon_items",
        "precalibration_horizon_charged_bytes",
        "max_calibration_frame_charged_bytes",
        "max_decoder_staging_bytes",
        "on_end_of_input"
      ],
      "properties": {
        "role": { "enum": ["none", "producer", "consumer"] },
        "binding_id": { "type": "string", "maxLength": 128 },
        "key_projection": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "single_epoch_v1": { "const": true },
        "max_active_keys": { "$ref": "#/$defs/safeInteger" },
        "precalibration_horizon_items": { "$ref": "#/$defs/safeInteger" },
        "precalibration_horizon_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "max_calibration_frame_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "max_decoder_staging_bytes": { "$ref": "#/$defs/safeInteger" },
        "on_end_of_input": { "enum": ["fail", "partial_output", "skip"] }
      },
      "additionalProperties": false
    },
    "joinInput": {
      "type": "object",
      "required": ["port_name", "key_projection", "required_items_per_key"],
      "properties": {
        "port_name": { "$ref": "#/$defs/identifier" },
        "key_projection": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "required_items_per_key": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "join": {
      "type": "object",
      "required": [
        "inputs",
        "max_retained_items_per_key",
        "max_retained_charged_bytes_per_key",
        "max_retained_items_aggregate",
        "max_retained_charged_bytes_aggregate",
        "require_matching_calibration_version",
        "exactly_once",
        "on_end_of_input",
        "progress_proof"
      ],
      "properties": {
        "inputs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/joinInput" } },
        "max_retained_items_per_key": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_retained_charged_bytes_per_key": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_retained_items_aggregate": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_retained_charged_bytes_aggregate": { "$ref": "#/$defs/positiveSafeInteger" },
        "require_matching_calibration_version": { "type": "boolean" },
        "exactly_once": { "const": true },
        "on_end_of_input": { "enum": ["fail", "partial_output", "skip"] },
        "progress_proof": { "enum": ["none", "verified_schedule_automaton", "cohort_reservation"] }
      },
      "additionalProperties": false
    },
    "reorder": {
      "type": "object",
      "required": [
        "completed_frame_input_port",
        "ordered_output_port",
        "outputs_per_ordinal",
        "order_projection",
        "max_ahead_items",
        "max_ahead_charged_bytes",
        "missing_at_end_of_input"
      ],
      "properties": {
        "completed_frame_input_port": {
          "$ref": "#/$defs/identifier",
          "description": "The immutable ksj.kspace-frame BufferHandle input carrying the completed FrameSlotContext semantic key used by M3. It is a host binding, never a Provider ordinal source."
        },
        "ordered_output_port": {
          "$ref": "#/$defs/identifier",
          "description": "The one Provider output port ordered by the M3 dense Cartesian ReorderPlan."
        },
        "outputs_per_ordinal": {
          "const": 1,
          "description": "M3 admits exactly one OutputEnvelope per dense ordinal."
        },
        "order_projection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" },
          "description": "M3 allows only a compiler-derived dense Cartesian ordinal over XML index fields of the completed FrameSlotContext semantic key; Providers do not supply an ordinal source."
        },
        "max_ahead_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_ahead_charged_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "missing_at_end_of_input": { "const": "fail" }
      },
      "additionalProperties": false
    },
    "terminal": {
      "type": "object",
      "required": [
        "normal",
        "cancel",
        "normal_max_output_items",
        "normal_max_output_charged_bytes",
        "normal_max_async_tokens",
        "cancel_max_async_tokens"
      ],
      "properties": {
        "normal": { "enum": ["none", "flush_declared"] },
        "cancel": { "enum": ["none", "cleanup_declared"] },
        "normal_max_output_items": { "$ref": "#/$defs/safeInteger" },
        "normal_max_output_charged_bytes": { "$ref": "#/$defs/safeInteger" },
        "normal_max_async_tokens": { "$ref": "#/$defs/safeInteger" },
        "cancel_max_async_tokens": { "$ref": "#/$defs/safeInteger" }
      },
      "additionalProperties": false
    }
  }
}
