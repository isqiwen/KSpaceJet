{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/machine-policy.schema.json",
  "title": "KSpaceJet MachinePolicy source configuration",
  "description": "A small, human-authored development policy declaring only the execution profile and machine ceilings needed before planning. It is not a ResourceVector serialization, a scheduler configuration, or evidence that GPU execution exists.",
  "type": "object",
  "required": [
    "kind",
    "id",
    "execution_profile",
    "limits"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.kspacejet.org/machine-policy.schema.json"
    },
    "kind": {
      "const": "MachinePolicy"
    },
    "id": {
      "$ref": "#/$defs/qualifiedIdentifier"
    },
    "execution_profile": {
      "const": "offline-reference"
    },
    "limits": {
      "$ref": "#/$defs/machineLimits"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveByteQuantity": {
      "description": "A positive exact byte quantity with a compact binary suffix, such as '32G'. K/M/G/T mean KiB/MiB/GiB/TiB.",
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:B|K|M|G|T)$"
    },
    "qualifiedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "machineLimits": {
      "type": "object",
      "required": [
        "max_host_memory_bytes",
        "max_cpu_permits",
        "max_io_slots",
        "gpu_enabled"
      ],
      "properties": {
        "max_host_memory_bytes": {
          "$ref": "#/$defs/positiveByteQuantity"
        },
        "max_cpu_permits": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "max_io_slots": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "gpu_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
