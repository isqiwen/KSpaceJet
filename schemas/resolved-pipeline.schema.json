{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/resolved-pipeline.schema.json",
  "title": "KSpaceJet ResolvedPipeline",
  "description": "Exact, content-addressed Provider bundle snapshot for an authored PipelineDefinition. This artifact is deliberately profile-neutral; PlanBuildRequest selects a profile later.",
  "type": "object",
  "required": [
    "kind",
    "pipeline_definition_artifact_digest",
    "providers",
    "nodes"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "kind": {
      "const": "ResolvedPipeline"
    },
    "pipeline_definition_artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resolvedProvider"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resolvedNodeConfig"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "qualifiedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resolvedOperator": {
      "type": "object",
      "required": [
        "id",
        "contract_digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "contract_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "additionalProperties": false
    },
    "resolvedProvider": {
      "type": "object",
      "required": [
        "alias",
        "provider_id",
        "bundle_digest",
        "operators"
      ],
      "properties": {
        "alias": {
          "$ref": "#/$defs/identifier"
        },
        "provider_id": {
          "$ref": "#/$defs/qualifiedIdentifier"
        },
        "bundle_digest": {
          "$ref": "#/$defs/digest"
        },
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/resolvedOperator"
          }
        }
      },
      "additionalProperties": false
    },
    "resolvedNodeConfig": {
      "type": "object",
      "required": [
        "id",
        "config"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "config": {
          "$ref": "#/$defs/authoredObject"
        }
      },
      "additionalProperties": false
    },
    "authoredValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "boolean",
            "null"
          ]
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/authoredValue"
          }
        },
        {
          "$ref": "#/$defs/authoredObject"
        }
      ]
    },
    "authoredObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/authoredValue"
      }
    }
  }
}
