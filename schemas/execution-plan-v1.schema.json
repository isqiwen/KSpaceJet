{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/v1/execution-plan-v1.schema.json",
  "title": "KSpaceJet ExecutionPlan v1",
  "description": "Frozen scan-specific physical plan. Dense KeySlot tables, M3 dense Cartesian ReorderPlans, runtime capacities, multi-domain resources, and terminal occurrence count live here and never in PipelineDefinition or ResolvedPipeline.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "input_digests",
    "execution_profile",
    "key_slot_tables",
    "reorder_plans",
    "buffer_pool_plans",
    "data_edge_plans",
    "edge_capacities",
    "resource_vector",
    "terminal_occurrences",
    "proof_obligations"
  ],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_version": { "const": "kspacejet.execution-plan/v1" },
    "kind": { "const": "ExecutionPlan" },
    "input_digests": { "$ref": "#/$defs/inputDigests" },
    "execution_profile": { "$ref": "#/$defs/executionProfile" },
    "key_slot_tables": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/keySlotTable" }
    },
    "reorder_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/reorderPlan" }
    },
    "buffer_pool_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/bufferPoolPlan" }
    },
    "data_edge_plans": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataEdgePlan" }
    },
    "edge_capacities": {
      "type": "array",
      "items": { "$ref": "#/$defs/edgeCapacity" }
    },
    "resource_vector": { "$ref": "#/$defs/resourceVector" },
    "terminal_occurrences": { "$ref": "#/$defs/positiveSafeInteger" },
    "proof_obligations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "executionProfile": {
      "type": "string",
      "enum": [
        "offline",
        "bounded-online",
        "isolated-strict-online",
        "deadline-qualified-online",
        "research-unbounded"
      ]
    },
    "inputDigests": {
      "type": "object",
      "required": [
        "resolved_pipeline",
        "scan_descriptor",
        "target_envelope",
        "machine_policy",
        "provider_contracts"
      ],
      "properties": {
        "resolved_pipeline": { "$ref": "#/$defs/digest" },
        "scan_descriptor": { "$ref": "#/$defs/digest" },
        "target_envelope": { "$ref": "#/$defs/digest" },
        "machine_policy": { "$ref": "#/$defs/digest" },
        "provider_contracts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      },
      "additionalProperties": false
    },
    "denseKeySlotDimension": {
      "type": "object",
      "required": ["field", "minimum", "cardinality"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "minimum": { "$ref": "#/$defs/safeInteger" },
        "cardinality": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "keySlotTable": {
      "type": "object",
      "required": [
        "node_id",
        "dense_dimensions",
        "mapping_algorithm_id",
        "storage_accounting_id",
        "key_domain_bound",
        "max_distinct_keys",
        "max_live_keys",
        "slot_count",
        "generation_policy",
        "initial_generation",
        "seal_on_completion",
        "eviction_policy",
        "late_event_policy",
        "host_metadata_charged_bytes",
        "max_items_per_activation",
        "max_charged_bytes_per_activation"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "dense_dimensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/denseKeySlotDimension" },
          "description": "Ordered mixed-radix axes. The compiler/verifier require unique field names and derive their checked product."
        },
        "mapping_algorithm_id": { "const": "dense-mixed-radix/v1" },
        "storage_accounting_id": { "const": "kspacejet.key-slot-storage/dense-v1" },
        "key_domain_bound": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal the checked dense_dimensions mixed-radix product."
        },
        "max_distinct_keys": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal key_domain_bound for the fixed dense semantic domain."
        },
        "max_live_keys": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must be no greater than key_domain_bound; it is the fixed physical reusable-slot capacity."
        },
        "slot_count": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal max_live_keys."
        },
        "generation_policy": { "const": "monotonic-u64/v1" },
        "initial_generation": { "const": 1 },
        "seal_on_completion": { "const": true },
        "eviction_policy": { "const": "completed-only" },
        "late_event_policy": { "const": "fail" },
        "host_metadata_charged_bytes": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal 16 * key_domain_bound + 16 * slot_count under kspacejet.key-slot-storage/dense-v1. Provider per-key state is charged separately."
        },
        "max_items_per_activation": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_charged_bytes_per_activation": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "denseCartesianOrdinalDimension": {
      "type": "object",
      "required": ["field", "minimum", "cardinality"],
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "minimum": { "$ref": "#/$defs/safeInteger" },
        "cardinality": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "reorderPlan": {
      "type": "object",
      "required": [
        "node_id",
        "order_domain_id",
        "ordinal_binding_id",
        "completed_frame_input_port",
        "ordered_output_port",
        "outputs_per_ordinal",
        "charged_bytes_per_ordinal",
        "ordinal_dimensions",
        "mapping_algorithm_id",
        "storage_accounting_id",
        "ordinal_domain_bound",
        "first_expected_ordinal",
        "last_expected_ordinal",
        "max_ahead_items",
        "max_ahead_charged_bytes",
        "max_gap_ordinals",
        "occurrence_policy",
        "publish_policy",
        "certified_skipped_ordinals",
        "end_of_input_policy",
        "handle_storage_charged_bytes",
        "host_metadata_charged_bytes",
        "descriptor_charged_count"
      ],
      "properties": {
        "node_id": { "$ref": "#/$defs/identifier" },
        "order_domain_id": {
          "$ref": "#/$defs/identifier",
          "description": "Explicit identity of the node-local M3 output-order domain; semantic validation requires it to equal node_id and to be backed by that node's KeySlotTable."
        },
        "ordinal_binding_id": {
          "const": "completed-frame-slot-context-semantic-key/v1",
          "description": "Frozen host-only M3 ordinal binding. The ordinal derives from a completed FrameSlotContext semantic key, never an acquisition event or Provider-defined ordinal."
        },
        "completed_frame_input_port": {
          "$ref": "#/$defs/identifier",
          "description": "Exact ksj.kspace-frame input port that carries the completed FrameSlotContext bound by ordinal_binding_id."
        },
        "ordered_output_port": {
          "$ref": "#/$defs/identifier",
          "description": "The selected Provider output stream whose envelopes consume dense ordinals."
        },
        "outputs_per_ordinal": { "const": 1 },
        "charged_bytes_per_ordinal": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Independently derived full-reservation byte bound for the one selected OutputEnvelope."
        },
        "ordinal_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/denseCartesianOrdinalDimension" },
          "description": "Ordered XML-derived Cartesian axes. The compiler/verifier require unique field names and derive their checked mixed-radix product."
        },
        "mapping_algorithm_id": { "const": "dense-cartesian-ordinal/v1" },
        "storage_accounting_id": { "const": "kspacejet.reorder-storage/dense-cartesian-v1" },
        "ordinal_domain_bound": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal the checked ordinal_dimensions mixed-radix product."
        },
        "first_expected_ordinal": {
          "const": 0,
          "description": "M3 always begins at the first ordinal in the dense closed domain."
        },
        "last_expected_ordinal": {
          "$ref": "#/$defs/safeInteger",
          "description": "Must equal ordinal_domain_bound - 1."
        },
        "max_ahead_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_ahead_charged_bytes": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must cover max_ahead_items full charged_bytes_per_ordinal reservations."
        },
        "max_gap_ordinals": {
          "$ref": "#/$defs/safeInteger",
          "description": "Closed-domain arithmetic upper bound only: it must equal ordinal_domain_bound - 1. It is not an ahead window, dispatch policy, or allowance to skip a dense ordinal."
        },
        "occurrence_policy": {
          "const": "strict-dense-all-tuples-eoi-fail",
          "description": "XML-derived dimensions are the expected complete tuple universe, not pre-admission proof of observed acquisition coverage. The future host frame-completion binding and runtime must fail at EndOfInput unless exactly one completed FrameSlotContext was observed for every dense ordinal."
        },
        "publish_policy": { "const": "next-expected-only" },
        "certified_skipped_ordinals": {
          "type": "array",
          "maxItems": 0,
          "items": { "$ref": "#/$defs/safeInteger" },
          "description": "Explicitly empty in M3; gaps are never certificate-skipped."
        },
        "end_of_input_policy": { "const": "fail" },
        "handle_storage_charged_bytes": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal 64 * max_ahead_items for immutable BufferHandle sidecars; it is included in host_metadata_charged_bytes, not a second physical payload charge."
        },
        "host_metadata_charged_bytes": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal 16 * ordinal_domain_bound + 16 * max_ahead_items + 64 * max_ahead_items under kspacejet.reorder-storage/dense-cartesian-v1."
        },
        "descriptor_charged_count": {
          "$ref": "#/$defs/positiveSafeInteger",
          "description": "Must equal max_ahead_items and is charged against the plan ResourceVector."
        }
      },
      "additionalProperties": false
    },
    "typeDescriptor": {
      "type": "object",
      "required": [
        "type_id",
        "revision",
        "abi_descriptor_digest",
        "payload_schema_digest",
        "payload_kind",
        "element_type",
        "rank",
        "dimensions",
        "layout",
        "strides",
        "explicit_byte_strides",
        "allowed_memory_domains",
        "min_alignment_bytes",
        "mutability",
        "metadata_schema_digest"
      ],
      "properties": {
        "type_id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z](?:[a-z0-9._-]*[a-z0-9])?$" },
        "revision": { "$ref": "#/$defs/positiveSafeInteger" },
        "abi_descriptor_digest": { "$ref": "#/$defs/digest" },
        "payload_schema_digest": { "$ref": "#/$defs/digest" },
        "payload_kind": { "const": "buffer_handle" },
        "element_type": { "enum": ["uint8", "int16", "uint16", "int32", "uint32", "float32", "float64", "complex_int16", "complex_float32", "complex_float64"] },
        "rank": { "$ref": "#/$defs/safeInteger" },
        "dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z](?:[a-z0-9._-]*[a-z0-9])?$" } },
        "layout": { "enum": ["canonical_contiguous", "channel_major_contiguous", "row_major_contiguous", "column_major_contiguous", "opaque"] },
        "strides": { "enum": ["canonical", "explicit_byte_strides"] },
        "explicit_byte_strides": { "type": "array", "items": { "$ref": "#/$defs/positiveSafeInteger" } },
        "allowed_memory_domains": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["host_normal", "host_pinned", "host_hugepage", "shared_host", "cuda_device"] } },
        "min_alignment_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "mutability": { "const": "immutable_after_publish" },
        "metadata_schema_digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        { "if": { "properties": { "strides": { "const": "canonical" } } }, "then": { "properties": { "explicit_byte_strides": { "maxItems": 0 } } } }
      ],
      "additionalProperties": false
    },
    "bufferPoolPlan": {
      "type": "object",
      "required": ["pool_id", "producer_node_id", "producer_port_name", "producer_provider_id", "producer_bundle_digest", "producer_operator_id", "producer_contract_digest", "type_descriptor", "memory_domain", "slot_count", "payload_capacity_bytes", "metadata_capacity_bytes", "payload_alignment_bytes", "storage_accounting_id", "host_metadata_charged_bytes", "descriptor_charged_count", "physical_charge_bytes"],
      "properties": {
        "pool_id": { "$ref": "#/$defs/identifier" },
        "producer_node_id": { "$ref": "#/$defs/identifier" },
        "producer_port_name": { "$ref": "#/$defs/identifier" },
        "producer_provider_id": { "$ref": "#/$defs/identifier", "description": "Resolved ProviderDescriptor.provider_id authorized to fill this pool." },
        "producer_bundle_digest": { "$ref": "#/$defs/digest", "description": "Resolved ProviderDescriptor.bundle_digest authorized to fill this pool." },
        "producer_operator_id": { "$ref": "#/$defs/identifier", "description": "Resolved Provider operator_id authorized to fill this pool." },
        "producer_contract_digest": { "$ref": "#/$defs/digest", "description": "Resolved Provider operator contract digest authorized to fill this pool; it must also occur in input_digests.provider_contracts." },
        "type_descriptor": { "$ref": "#/$defs/typeDescriptor" },
        "memory_domain": { "const": "host_normal" },
        "slot_count": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal the full DataEdgePlan.max_items. That edge credit already includes base downstream occupancy plus matching ReorderPlan.max_ahead_items and is acquired before a mutable lease, so no extra physical slot term exists." },
        "payload_capacity_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "metadata_capacity_bytes": { "$ref": "#/$defs/safeInteger" },
        "payload_alignment_bytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "storage_accounting_id": { "const": "kspacejet.buffer-pool-storage/host-normal-v1" },
        "host_metadata_charged_bytes": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal 40 * slot_count." },
        "descriptor_charged_count": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal slot_count." },
        "physical_charge_bytes": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal slot_count * (payload_capacity_bytes + metadata_capacity_bytes + 40); this is the only physical payload charge." }
      },
      "additionalProperties": false
    },
    "dataEdgePlan": {
      "type": "object",
      "required": ["edge_id", "source_pool_id", "producer_node_id", "producer_port_name", "producer_abi_port", "consumer_node_id", "consumer_port_name", "type_descriptor", "max_items", "max_logical_bytes", "storage_accounting_id", "host_metadata_charged_bytes", "descriptor_charged_count", "firing_lease_staging_charged_bytes", "firing_lease_staging_descriptor_count", "terminal_policy"],
      "properties": {
        "edge_id": { "$ref": "#/$defs/identifier" },
        "source_pool_id": { "$ref": "#/$defs/identifier" },
        "producer_node_id": { "$ref": "#/$defs/identifier" },
        "producer_port_name": { "$ref": "#/$defs/identifier" },
        "producer_abi_port": { "type": "integer", "minimum": 0, "maximum": 4294967295, "description": "Zero-based position among OperatorContract ports whose direction is output, preserving declared array order. The resolved contract digest binds that order." },
        "consumer_node_id": { "$ref": "#/$defs/identifier" },
        "consumer_port_name": { "$ref": "#/$defs/identifier" },
        "type_descriptor": { "$ref": "#/$defs/typeDescriptor" },
        "max_items": { "$ref": "#/$defs/positiveSafeInteger", "description": "For M3.7 selected reordered output, must equal base downstream edge capacity plus ReorderPlan.max_ahead_items. One logical edge credit follows each payload across reorder to FIFO." },
        "max_logical_bytes": { "$ref": "#/$defs/positiveSafeInteger", "description": "Logical pool payload/metadata credit only; it must not be charged as a second physical allocation." },
        "storage_accounting_id": { "const": "kspacejet.data-edge-storage/fixed-fifo-v1" },
        "host_metadata_charged_bytes": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal 96 * max_items; frozen abstract fixed-FIFO control charge." },
        "descriptor_charged_count": { "$ref": "#/$defs/positiveSafeInteger", "description": "Must equal max_items." },
        "firing_lease_staging_charged_bytes": { "const": 4096, "description": "Frozen M3.7 synchronous Provider ABI staging for exactly one input batch/item, output grant/sealed output, and lease control; runtime proves concrete storage fits." },
        "firing_lease_staging_descriptor_count": { "const": 5, "description": "Frozen descriptor charge for that one M3.7 ABI staging endpoint." },
        "terminal_policy": { "const": "normal-eoi-drain-cancellation-fail" }
      },
      "additionalProperties": false
    },
    "edgeCapacity": {
      "type": "object",
      "required": ["edge_id", "max_items", "max_charged_bytes"],
      "properties": {
        "edge_id": { "$ref": "#/$defs/identifier" },
        "max_items": { "$ref": "#/$defs/positiveSafeInteger" },
        "max_charged_bytes": { "$ref": "#/$defs/positiveSafeInteger" }
      },
      "additionalProperties": false
    },
    "deviceResourceSlot": {
      "type": "object",
      "required": ["device_id", "device_bytes", "gpu_stream_slots", "copy_engine_slots"],
      "properties": {
        "device_id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "device_bytes": { "$ref": "#/$defs/safeInteger" },
        "gpu_stream_slots": { "$ref": "#/$defs/safeInteger" },
        "copy_engine_slots": { "$ref": "#/$defs/safeInteger" }
      },
      "additionalProperties": false
    },
    "resourceVector": {
      "type": "object",
      "required": [
        "host_normal_bytes",
        "host_pinned_bytes",
        "host_hugepage_bytes",
        "shared_host_bytes",
        "spool_bytes",
        "transport_bytes",
        "descriptor_count",
        "async_token_count",
        "cpu_leaf_permits",
        "backend_gang_permits",
        "provider_private_permits",
        "io_slots",
        "devices"
      ],
      "properties": {
        "host_normal_bytes": { "$ref": "#/$defs/safeInteger" },
        "host_pinned_bytes": { "$ref": "#/$defs/safeInteger" },
        "host_hugepage_bytes": { "$ref": "#/$defs/safeInteger" },
        "shared_host_bytes": { "$ref": "#/$defs/safeInteger" },
        "spool_bytes": { "$ref": "#/$defs/safeInteger" },
        "transport_bytes": { "$ref": "#/$defs/safeInteger" },
        "descriptor_count": { "$ref": "#/$defs/safeInteger" },
        "async_token_count": { "$ref": "#/$defs/safeInteger" },
        "cpu_leaf_permits": { "$ref": "#/$defs/safeInteger" },
        "backend_gang_permits": { "$ref": "#/$defs/safeInteger" },
        "provider_private_permits": { "$ref": "#/$defs/safeInteger" },
        "io_slots": { "$ref": "#/$defs/safeInteger" },
        "devices": {
          "type": "array",
          "items": { "$ref": "#/$defs/deviceResourceSlot" }
        }
      },
      "additionalProperties": false
    }
  }
}
