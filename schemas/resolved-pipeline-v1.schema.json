{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/v1/resolved-pipeline-v1.schema.json",
  "title": "KSpaceJet ResolvedPipeline v1",
  "description": "Exact, content-addressed Provider/contract snapshot for an authored PipelineDefinition. This artifact is deliberately profile-neutral; PlanBuildRequest selects a profile later.",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "pipeline_definition_artifact_digest",
    "pipeline_definition_semantic_digest",
    "providers"
  ],
  "properties": {
    "$schema": { "const": "https://json-schema.org/draft/2020-12/schema" },
    "schema_version": { "const": "kspacejet.resolved-pipeline/v1" },
    "kind": { "const": "ResolvedPipeline" },
    "pipeline_definition_artifact_digest": { "$ref": "#/$defs/digest" },
    "pipeline_definition_semantic_digest": { "$ref": "#/$defs/digest" },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resolvedProvider" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "qualifiedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "resolvedOperator": {
      "type": "object",
      "required": ["id", "interface_revision", "contract_digest"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "interface_revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "contract_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "resolvedProvider": {
      "type": "object",
      "required": ["alias", "provider_id", "version", "abi_major", "bundle_digest", "operators"],
      "properties": {
        "alias": { "$ref": "#/$defs/identifier" },
        "provider_id": { "$ref": "#/$defs/qualifiedIdentifier" },
        "version": { "$ref": "#/$defs/semver" },
        "abi_major": { "$ref": "#/$defs/positiveSafeInteger" },
        "bundle_digest": { "$ref": "#/$defs/digest" },
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resolvedOperator" }
        }
      },
      "additionalProperties": false
    }
  }
}
