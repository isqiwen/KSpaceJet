{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kspacejet.org/target-envelope.schema.json",
  "title": "KSpaceJet TargetEnvelope source configuration",
  "description": "A small, human-authored development envelope declaring the input, frame, image, and scan ceilings for one supported task class. It is not an arrival-rate, sink-service, calibration, or scanner contract.",
  "type": "object",
  "required": [
    "kind",
    "id",
    "limits"
  ],
  "properties": {
    "$schema": {
      "const": "https://schemas.kspacejet.org/target-envelope.schema.json"
    },
    "kind": {
      "const": "TargetEnvelope"
    },
    "id": {
      "$ref": "#/$defs/qualifiedIdentifier"
    },
    "limits": {
      "$ref": "#/$defs/targetLimits"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveByteQuantity": {
      "description": "A positive exact byte quantity with a compact binary suffix, such as '4M'. K/M/G/T mean KiB/MiB/GiB/TiB.",
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:B|K|M|G|T)$"
    },
    "qualifiedIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "targetLimits": {
      "type": "object",
      "required": [
        "max_xml_bytes",
        "max_acquisition_bytes",
        "max_frame_bytes",
        "max_image_bytes",
        "max_samples_per_acquisition",
        "max_channels_per_acquisition",
        "max_active_scans"
      ],
      "properties": {
        "max_xml_bytes": {
          "$ref": "#/$defs/positiveByteQuantity"
        },
        "max_acquisition_bytes": {
          "$ref": "#/$defs/positiveByteQuantity"
        },
        "max_frame_bytes": {
          "$ref": "#/$defs/positiveByteQuantity"
        },
        "max_image_bytes": {
          "$ref": "#/$defs/positiveByteQuantity"
        },
        "max_samples_per_acquisition": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "max_channels_per_acquisition": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "max_active_scans": {
          "$ref": "#/$defs/positiveSafeInteger"
        }
      },
      "additionalProperties": false
    }
  }
}
