# This file is consumed by both cross-platform bootstrap scripts.  Update a
# version only together with its checksum, pyproject.toml/uv.lock (when
# relevant), and Linux + Windows verification.
KSJ_UV_VERSION=0.12.3
KSJ_UV_LINUX_X86_64_SHA256=600cf9a742aca00d292673b16b5acffaa7b8c269a364ad0c2e79498dcb1fe101
