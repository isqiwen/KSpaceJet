# Verify the installed executable as well as its downloaded archive.  This
# catches a modified project-local cache before it is executed on a later run.
KSJ_UV_LINUX_X86_64_BINARY_SHA256=729d27dbea534ee540a2d3ef43a62fa1a10af7fcbb6d57a70d5859509f624578
KSJ_UV_WINDOWS_X86_64_BINARY_SHA256=68a22cbab1674647bcda32120b214e6480f875414e3333f49f87ae99b4b0e0fa
# `just` is a native cross-platform command runner, so it is deliberately
# bootstrapped as a separate checksum-verified project-local artifact instead
# of being taken from a system PATH or a Python virtual environment.
KSJ_JUST_VERSION=1.58.0
KSJ_JUST_LINUX_X86_64_SHA256=4a5cc2f53e6f0f8c59092a6cc38291eb729d46a7dd95d3ae582008881b84931d
