# Default: normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Explicit text file types
*.c       text eol=lf
*.cc      text eol=lf
*.cp      text eol=lf
*.cpp     text eol=lf
*.cxx     text eol=lf
*.h       text eol=lf
*.hh      text eol=lf
*.hpp     text eol=lf
*.hxx     text eol=lf
*.ipp     text eol=lf
*.ixx     text eol=lf
*.cppm    text eol=lf
*.tpp     text eol=lf
*.py      text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
*.ps1     text eol=lf
*.psm1    text eol=lf
*.psd1    text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.xml     text eol=lf
# Treat common binary assets as binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.7z      binary
*.tar     binary
*.gz      binary
*.tgz     binary
*.bz2     binary
*.xz      binary
*.a       binary
*.lib     binary
*.so      binary
*.dylib   binary
*.dll     binary
*.exe     binary
*.obj     binary
*.o       binary
*.pdb     binary
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pb filter=lfs diff=lfs merge=lfs -text
*.mat filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.tar.xz filter=lfs diff=lfs merge=lfs -text
*.nupkg filter=lfs diff=lfs merge=lfs -text
*.ort filter=lfs diff=lfs merge=lfs -text

# Fixed replay regression assets are versioned through Git LFS.
tests/data/replay/*.brf filter=lfs diff=lfs merge=lfs -text
tests/data/replay/*.dat filter=lfs diff=lfs merge=lfs -text
tests/data/replay/**/*.brf filter=lfs diff=lfs merge=lfs -text
tests/data/replay/**/*.dat filter=lfs diff=lfs merge=lfs -text

*.dll filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.pdb filter=lfs diff=lfs merge=lfs -text
*.exe filter=lfs diff=lfs merge=lfs -text

# The reviewed oneAPI payload is binary-only and is shipped with release
# checkouts through Git LFS. Its manifest, licences and recipe remain regular
# text files so they are reviewable in Git.
third_party/intel/payload/** filter=lfs diff=lfs merge=lfs -text
third_party/intel/payload/**/manifest-files.json -filter -diff -merge text eol=lf
