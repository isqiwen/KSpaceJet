/dpc-release/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
# The KSpaceJet developer-tool interpreter is pinned and versioned.  Local
# virtual environments and uv's project-local caches remain untracked.
!.python-version

.venv/
venv/
env/
/.kspacejet/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

.coverage
.coverage.*
htmlcov/

dist/
site/
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Logs / temp
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
.cache/

# -----------------------------------------------------------------------------
# Generated protocol buffers
# -----------------------------------------------------------------------------
*.pb.cc
*.pb.h

# Bundled WF2 prebuilt runtime libraries that are intentionally versioned
!apps/dpc-dixon/prebuilt/
!apps/dpc-dixon/prebuilt/**

# Reviewed Intel oneAPI payloads are intentionally versioned through Git LFS.
!third_party/intel/payload/
!third_party/intel/payload/**

# Public MRI reconstruction inputs are acquired locally for research and must
# never be committed implicitly.  Their manifests, source evidence and fetcher
# remain versioned under research/benchmarks/datasets/.
/research/benchmarks/datasets/raw/
/research/benchmarks/datasets/canonical/
/research/benchmarks/datasets/derived/
/research/benchmarks/datasets/.download-state/
/research/benchmarks/artifacts/
