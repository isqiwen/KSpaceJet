{
  "kind": "OperatorInterface",
  "availability": "planned",
  "provider_id": "org.kspacejet.image-quality",
  "operator_id": "image_range_check",
  "summary": "Check one image against configured intensity bounds, forward it on success, and emit a quality report.",
  "ports": [
    {
      "name": "image",
      "direction": "input",
      "semantic_type": "ksj.image-frame"
    },
    {
      "name": "validated_image",
      "direction": "output",
      "semantic_type": "ksj.image-frame"
    },
    {
      "name": "quality_report",
      "direction": "output",
      "semantic_type": "ksj.image-quality-report"
    }
  ],
  "configuration": {
    "kind": "object",
    "required": ["maximum", "minimum", "policy"],
    "optional": []
  },
  "notes": "The future executable contract must define comparison and non-finite policy, report delivery, exact descriptors, resource bounds, and terminal behavior."
}
