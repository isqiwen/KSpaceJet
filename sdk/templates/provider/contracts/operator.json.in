{
  "kind": "OperatorContract",
  "operator_id": "@OPERATOR_ID@",
  "ports": [
    {
      "name": "@INPUT_PORT@",
      "type_ref": "@INPUT_TYPE_REF@",
      "direction": "input"
    },
    {
      "name": "@OUTPUT_PORT@",
      "type_ref": "@OUTPUT_TYPE_REF@",
      "direction": "output"
    }
  ]
}
