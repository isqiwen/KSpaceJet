        "--preset",
        "windows-vs2022-debug",
        "--target",
        "ksj_cli",
        "ksj_gateway",
        "ksj_recon",
        "ksj_research"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "KSJ: install Windows Debug applications",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\devenv\\windows\\run.ps1",
        "cmake",
