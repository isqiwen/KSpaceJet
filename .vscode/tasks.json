        "${workspaceFolder}\\tools\\devenv\\windows\\bootstrap.ps1",
        "-Prepare",
        "windows-vs2022-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: build Windows Release applications",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\devenv\\windows\\run.ps1",
        "cmake",
        "--build",
        "--preset",
        "windows-vs2022-release",
        "--target",
        "ksj_cli",
