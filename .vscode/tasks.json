{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "KSJ: bootstrap developer environment",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/tools/devenv/linux/bootstrap.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\devenv\\windows\\bootstrap.ps1"
        ]
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: prepare Linux Debug environment",
      "type": "shell",
      "command": "just",
      "args": [
        "prepare-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: build Linux Debug applications",
      "type": "shell",
      "command": "just",
      "args": [
        "build-debug-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "KSJ: install Linux Debug applications",
      "type": "shell",
      "command": "just",
      "args": [
        "install-debug-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "KSJ: build Linux Debug applications",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "KSJ: prepare Linux Release environment",
      "type": "shell",
      "command": "just",
      "args": [
        "prepare-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: build Linux Release applications",
      "type": "shell",
      "command": "just",
      "args": [
        "build-release-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "KSJ: install Linux Release applications",
      "type": "shell",
      "command": "just",
      "args": [
        "install-release-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "KSJ: build Linux Release applications",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "KSJ: prepare Windows Debug environment",
      "type": "shell",
      "command": "just",
      "args": [
        "prepare-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: build Windows Debug applications",
      "type": "shell",
      "command": "just",
      "args": [
        "build-debug-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "KSJ: install Windows Debug applications",
      "type": "shell",
      "command": "just",
      "args": [
        "install-debug-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "KSJ: build Windows Debug applications",
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "KSJ: prepare Windows Release environment",
      "type": "shell",
      "command": "just",
      "args": [
        "prepare-release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "KSJ: build Windows Release applications",
      "type": "shell",
      "command": "just",
      "args": [
        "build-release-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$msCompile"
      ]
    },
    {
      "label": "KSJ: install Windows Release applications",
      "type": "shell",
      "command": "just",
      "args": [
        "install-release-applications"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "KSJ: build Windows Release applications",
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
